# Which Kev checkpoint to serve: kev-0.8b, kev-4b, or kev-9b
KEV_MODEL=kev-4b

# Host port that serves http://<your-windows-ip>:<port>/v1/systemone
KEV_PORT=8008

# Optional: require "Authorization: Bearer $KEV_API_KEY" on every request.
# Leave empty for an open (unauthenticated) server on your LAN.
KEV_API_KEY=